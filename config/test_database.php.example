<?php
/**
 * Nook32 POS Test Database Configuration Template
 * Copy this file to config/test_database.php and update with your test database credentials.
 */

$host     = getenv('TEST_DB_HOST') ?: "localhost";
$username = getenv('TEST_DB_USER') ?: "root";
$password = getenv('TEST_DB_PASS') !== false ? getenv('TEST_DB_PASS') : "";
$database = getenv('TEST_DB_NAME') ?: "test";

mysqli_report(MYSQLI_REPORT_ERROR | MYSQLI_REPORT_STRICT);

$conn = new mysqli($host, $username, $password, $database);
$conn->set_charset("utf8mb4");
